#. Description of the plugin
#: index.php
msgid "Change any text of WordPress, WooCommerce, plugins and themes from the admin panel."
msgstr "Modifica qualsiasi testo di WordPress, WooCommerce, plugin e temi dal pannello di amministrazione."

#. Author of the plugin
#: index.php
msgid "Vincenzo Luongo"
msgstr "Vincenzo Luongo"

#. Author URI of the plugin
#: index.php
msgid "https://www.luongovincenzo.it/"
msgstr "https://www.luongovincenzo.it/"

#: index.php:62
msgid "Manage Translations"
msgstr "Gestisci traduzioni"

#: php/admin.php:18
msgid "Override Translations"
msgstr "Sovrascrivi traduzioni"

#: php/admin.php:49
msgid "You do not have sufficient permissions to access this page."
msgstr "Non hai i permessi sufficienti per accedere a questa pagina."

#: php/admin.php:81
msgid "Enter the text as your visitors see it (matching is case-insensitive) and the text to show instead. HTML is allowed in the replacement. If some text is still not replaced (e.g. text loaded by JavaScript), enable JS and enter the CSS selector of the element that contains it."
msgstr "Inserisci il testo come lo vedono i tuoi visitatori (maiuscole e minuscole sono indifferenti) e il testo da mostrare al suo posto. Nella nuova traduzione puoi usare l'HTML. Se un testo non viene comunque sostituito (ad es. un testo caricato via JavaScript), attiva JS e inserisci il selettore CSS dell'elemento che lo contiene."

#: php/admin.php:89
msgid "Translation Overrides"
msgstr "Traduzioni sovrascritte"

#: php/admin.php:96
#: php/admin.php:136
msgid "Original Translation"
msgstr "Traduzione originale"

#: php/admin.php:97
#: php/admin.php:139
msgid "New translation (Override)"
msgstr "Nuova traduzione"

#: php/admin.php:98
msgid "JS"
msgstr "JS"

#: php/admin.php:99
#: php/admin.php:145
msgid "CSS Selector"
msgstr "Selettore CSS"

#: php/admin.php:117
msgid "Save"
msgstr "Salva"

#: php/admin.php:118
msgid "Add New Override"
msgstr "Aggiungi traduzione"

#: php/admin.php:142
msgid "Enable JS"
msgstr "Attiva JS"

#: php/admin.php:145
msgid "e.g. #booking_date_from, .my-class"
msgstr "es. #booking_date_from, .mia-classe"

#: php/admin.php:148
msgid "Remove override"
msgstr "Rimuovi traduzione"
